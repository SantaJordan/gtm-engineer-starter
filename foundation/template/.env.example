# Copy this file to .env and fill in only the keys you need.
# .env is gitignored. Never commit real keys.
# Nothing here is needed for `make check`: the demo runs offline.

# --- Jev, the scorer (step 8). Set ONE of these. ---
# TypeSafe direct. Sign up at https://console.typesafe.ai . Tried first.
TYPESAFE_API_KEY=
# Or the same model through OpenRouter (model typesafe/jev-1.13).
OPENROUTER_API_KEY=

# --- Claude, for Won/Lost/10X (win-loss-rewind) ---
ANTHROPIC_API_KEY=

# --- Web evidence. Bring any one; each skill says which it uses. ---
FIRECRAWL_API_KEY=
EXA_API_KEY=
OPENWEBNINJA_API_KEY=
PARALLEL_API_KEY=
APIFY_TOKEN=

# --- Optional enrichment used by the data auditor ---
GROQ_API_KEY=
PERPLEXITY_API_KEY=
LINKUP_API_KEY=
DISCOLIKE_API_KEY=
MILLIONVERIFIER_API_KEY=
# DataForSEO: Google Maps listings in the packet builder (--maps-budget-usd)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Blitz: person profiles in the packet builder (--profiles) and the auditor
BLITZ_API_KEY=

# --- Call and CRM sources (win-loss-rewind adapters) ---
GONG_ACCESS_KEY=
GONG_SECRET_KEY=
# Your own Gong API host, e.g. https://us-XXXXX.api.gong.io (required for Gong pulls)
GONG_BASE_URL=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=

# --- Polite identification when scripts fetch public pages ---
# A User-Agent string, ideally with a contact URL you own.
CRAWFORD_USER_AGENT=
# Your contact email for the Wayback Machine (Internet Archive) requests.
WLR_CONTACT_EMAIL=

# --- Switches (optional) ---
# CALIBRATED_JUDGE_MODE=off        # off | shadow | active (library default: off)
# WLR_SONNET_MODEL=claude-sonnet-5-5
# WLR_OPUS_MODEL=claude-opus-5-5
